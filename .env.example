# Copy to .env and fill in. NEVER commit .env. Placeholders only in this file.

APP_ENV=development
# The public origin the web app is served from (no path). Production: your https Render URL.
PUBLIC_BASE_URL=http://localhost:8000

# --- Google AI Studio (free tier) ---
GEMINI_API_KEY=your-gemini-api-key

# --- LiveKit Cloud (Settings -> Keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Supabase: connection string of the LIMITED role `syl_app` (NOT the service_role key) ---
# Use the Supavisor pooler string (IPv4). Filled in after the schema script is run.
DATABASE_URL=postgresql://syl_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Proof token vault (server-side only) ---
# 32 random bytes, urlsafe-base64. Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Use a DIFFERENT key for production than for local dev.
TOKEN_ENC_KEY_ID=v1
TOKEN_ENC_KEY_V1=your-32-byte-urlsafe-base64-key
# Secret for hashing device-session cookies (generate the same way)
SESSION_HMAC_KEY=your-32-byte-urlsafe-base64-key
# Secret that signs the per-interview job token given to the voice agent (generate the same way).
# API only. SESSION_HMAC_KEY, TOKEN_ENC_KEY_V1 and AGENT_JOB_SECRET MUST be three different values
# (the API refuses to boot otherwise).
AGENT_JOB_SECRET=your-32-byte-urlsafe-base64-key

# --- Proof ---
PROOF_MCP_URL=https://proof.zeromaintenanceengineer.in/api/mcp
# Phase 0 spike only (reads tools/list). Your personal token; never paste it in chat.
PROOF_SPIKE_TOKEN=your-proof-token

# --- Voice agent (optional overrides; the agent reads GEMINI_API_KEY and LIVEKIT_* above) ---
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview   # fallback if the preview model changes: gemini-3.8-live
# GEMINI_VOICE=Kore
